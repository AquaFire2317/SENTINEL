# SENTINEL environment configuration.
# Copy to .env and adjust. All values are optional; the app runs offline with
# the deterministic local planner by default.

# --- Runtime ---------------------------------------------------------------
SENTINEL_ENV=local
SENTINEL_LOG_LEVEL=INFO

# --- Model provider (provider-agnostic) ------------------------------------
# One of: local | bedrock | anthropic | openai | openrouter | openai_compatible
#         | litellm | ollama | gemini | mistral
SENTINEL_MODEL_PROVIDER=local
SENTINEL_MODEL_ID=
SENTINEL_MODEL_API_KEY=
SENTINEL_MODEL_BASE_URL=

# Backwards-compatible alias: SENTINEL_MODE=bedrock selects Bedrock when no
# explicit provider is set.
SENTINEL_MODE=local

# --- AWS (durable persistence & orchestration; optional) --------------------
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
SENTINEL_TABLE_NAME=
SENTINEL_BUCKET_NAME=
SENTINEL_STATE_MACHINE_ARN=
SENTINEL_FIXTURE_VERSION=v1

# --- HTTP server ------------------------------------------------------------
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8080
SENTINEL_CORS_ORIGIN=*
SENTINEL_SERVE_FRONTEND=false
SENTINEL_FRONTEND_DIST=
